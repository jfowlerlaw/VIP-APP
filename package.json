{
  "name": "vip-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-sites.mjs",
    "start": "node server.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:open:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "vip-push-notifications": "file:plugins/vip-push-notifications"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2"
  }
}
