PORT=8787
HOST=127.0.0.1
VIP_ADMIN_PASSWORD=change-this-before-beta
VIP_DEV_CODE=246810
VIP_SHOW_CODES=true
VIP_REQUEST_EMAIL=vip@justcallmoe.com
VIP_FROM_EMAIL=vip@justcallmoe.com
VIP_FROM_NAME=Just Call Moe VIP Portal
# Required for emailed verification codes and concierge request emails.
SENDGRID_API_KEY=

# Required for sending iPhone push notifications from the admin dashboard.
# Use APNS_ENV=sandbox for local Xcode builds and APNS_ENV=production for TestFlight/App Store builds.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.justcallmoe.vip
APNS_ENV=sandbox
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=

# Optional: when these are set, the beta server uses Supabase/Postgres
# instead of the local data/vip-db.json file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
